<section id="contact" class="contact" data-aos="fade-up">

    <div class="container">

        <div class="text-center mb-5">
            <h5 class="section-title">CONTACT ME</h5>
            <h2>Let's Work Together</h2>
            <p>Have a project in mind? Feel free to contact me.</p>
        </div>

      

        <div class="row">

            <!-- Left Side -->
            <div class="col-lg-5">

                <div class="contact-info">

                    <div class="contact-box">
                        <i class="fas fa-envelope"></i>
                        <div>
                            <h5>Email</h5>
                            <p>dhanarajdoke10@gmail.com</p>
                        </div>
                    </div>

                    <div class="contact-box">
                        <i class="fas fa-phone"></i>
                        <div>
                            <h5>Phone</h5>
                            <p>+91 8530695082</p>
                        </div>
                    </div>

                    <div class="contact-box">
                        <i class="fas fa-location-dot"></i>
                        <div>
                            <h5>Location</h5>
                            <p>Maharashtra, India</p>
                        </div>
                    </div>

                </div>

            </div>

            <!-- Right Side -->
            <div class="col-lg-7">

                <form asp-controller="Home"
                      asp-action="Send"
                      method="post">

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <input asp-for="FullName" class="form-control" placeholder="Your Name" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <input asp-for="Email" class="form-control" placeholder="Your Email" />
                        </div>

                    </div>

                    <div class="mb-3">
                        <input asp-for="Subject" class="form-control" placeholder="Subject" />
                    </div>

                    <div class="mb-3">
                        <textarea asp-for="Message"
                                  class="form-control"
                                  rows="6"
                                  placeholder="Message"></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg">
                        Send Message
                    </button>

                </form>

            </div>

        </div>

    </div>

</section>
@section Scripts {

    @if (TempData["Success"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Message Sent!',
                text: '@TempData["Success"]',
                timer: 2000,
                showConfirmButton: false
            });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: 'Oops...',
                text: '@TempData["Error"]',
                confirmButtonColor: '#ef4444'
            });
        </script>
    }

    <script>

        function downloadResume() {

            Swal.fire({
                icon: 'success',
                title: 'Download Started',
                text: 'Your resume is downloading...',
                timer: 1500,
                showConfirmButton: false
            });

        }

    </script>
}


